{
  "name": "multiplay-saas",
  "version": "0.1.0",
  "description": "범용 멀티플레이 게임 서버 프레임워크 — 어떤 게임이든 GameModule을 꽂으면 룸/로비/세션/재접속/틱 동기화를 제공하는 self-hosted 멀티플레이 백엔드",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test test/*.unit.test.ts",
    "test:integration": "node test/smoke.mjs && node test/et-compat.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
